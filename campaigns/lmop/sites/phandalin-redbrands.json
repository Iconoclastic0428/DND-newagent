  "arrival_text": "The road opens onto Phandalin: timber buildings, busy wagons and the ruined manor on the eastern hill. Choose where to visit. The Redbrands are a lead, not a forced destination.",
  "places": [
    {
      "place_id": "barthens-provisions",
      "name": "Barthen's Provisions",
      "x": 0.518,
      "y": 0.294,
      "description": "A trading post beside the north road.",
      "conversations": [
        {
          "npc_id": "elmar-barthen",
          "label": "Ask Barthen about the town",
          "text": "Barthen welcomes the caravan. He describes the Redbrands' demands and points you toward Stonehill Inn and Tresendar Manor.",
          "grants": [
            "redbrand-trouble-known",
            "redbrand-base-known"
          ]
        }
      ]
    },
    {
      "place_id": "stonehill-inn",
      "name": "Stonehill Inn",
      "x": 0.455,
      "y": 0.399,
      "description": "A modest inn with a busy common room.",
      "conversations": [
        {
          "npc_id": "toblen-stonehill",
          "label": "Speak with Toblen",
          "text": "Toblen reports that the Redbrands murdered Thel Dendrar and took his family. Their usual haunt is the Sleeping Giant; their base is beneath Tresendar Manor.",
          "grants": [
            "redbrand-trouble-known",
            "redbrand-base-known",
            "missing-family-known"
          ]
        }
      ]
    },
    {
      "place_id": "townmasters-hall",
      "name": "Townmaster's Hall",
      "x": 0.433,
      "y": 0.507,
      "description": "Public notices hang outside the town hall.",
      "conversations": [
        {
          "npc_id": "harbin-wester",
          "label": "Question Harbin",
          "text": "Harbin minimizes the gang's danger, but admits that armed Redbrands shelter around Tresendar Manor. You may investigate without accepting his advice.",
          "grants": [
            "redbrand-base-known"
          ]
        }
      ]
    },
    {
      "place_id": "alderleaf-farm",
      "name": "Alderleaf Farm",
      "x": 0.656,
      "y": 0.665,
      "description": "A family farm near the southeastern woods.",
      "conversations": [
        {
          "npc_id": "carp-alderleaf",
          "label": "Ask Carp about the woods",
          "text": "Carp describes a hidden tunnel in the woods south of Tresendar Manor and the Redbrands he saw using it. He marks the approach on your map.",
          "grants": [
            "secret-tunnel-known",
            "redbrand-base-known"
          ]
        }
      ]
    },
    {
      "place_id": "sleeping-giant",
      "name": "The Sleeping Giant",
      "x": 0.619,
      "y": 0.405,
      "description": "A rough tavern frequented by scarlet-cloaked toughs.",
      "conversations": [
        {
          "npc_id": "grista",
          "label": "Ask Grista about the Redbrands",
          "text": "Grista identifies the gang's base beneath the ruined manor and their leader, a wizard called Glasstaff. The people here are wary of outsiders.",
          "grants": [
            "redbrand-base-known",
            "glasstaff-known"
          ]
        }
      ]
    },
    {
      "place_id": "tresendar-manor",
