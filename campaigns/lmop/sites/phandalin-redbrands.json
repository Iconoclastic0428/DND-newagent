      "x": 0.879,
      "y": 0.38,
      "description": "The ruined manor stands above the eastern edge of town.",
      "conversations": [
        {
          "npc_id": "manor-tracks",
          "label": "Inspect the manor ruins",
          "text": "Fresh tracks lead down a stone stair beside the ruined kitchen. A door at the bottom opens onto the hideout's cellar landing.",
          "grants": [
            "manor-entrance-known",
            "redbrand-base-known"
          ]
        }
      ]
    }
