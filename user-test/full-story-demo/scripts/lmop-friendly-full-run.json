{
  "script_id": "lmop-friendly-full-run",
  "description": "Friendly Waterdeep briefing, story check, helpful public magic, downtime, travel, and successful goblin-ambush resolution.",
  "consume_all_llm_payloads": true,
  "llm_payloads": [
    {
      "public_narration": "Gundren softens a fraction when you approach him with patience and real curiosity.",
      "transcript_entries": [
        {
          "speaker": "Gundren",
          "text": "Phandalin matters, and I would rather not trumpet every reason in a taproom.",
          "visibility": "public"
        }
      ],
      "check_request": {
        "actor_id": "player-1",
        "ability": "WIS",
        "skill_name": "Insight",
        "dc": 12,
        "prompt": "Make a Wisdom (Insight) check to read how much Gundren is still holding back.",
        "reason": "Gauge Gundren's caution without pushing him away.",
        "requires_sight": false,
        "requires_hearing": true,
        "interacting_with_actor_id": null
      },
      "scene_update": null,
      "mode_switch_decision": null,
      "memory_note": "Player 1 approached Gundren in a friendly way and looked for the truth behind his caution."
    },
    {
      "public_narration": "You catch that Gundren is excited, not duplicitous; he is guarding a discovery, not setting a trap for you.",
      "transcript_entries": [
        {
          "speaker": "DM",
          "text": "His caution looks like protectiveness around news from Phandalin, not deceit aimed at the party.",
          "visibility": "public"
        }
      ],
      "check_request": null,
      "scene_update": {
        "summary": "The party reads Gundren as excited and protective rather than treacherous.",
        "party_beliefs": [
          "Gundren is hiding the scale of a discovery near Phandalin, not preparing a betrayal."
        ],
        "open_loops": [
          "What exactly did Gundren and his brothers find?",
          "Why is he so eager to get there first?"
        ],
        "party_goals": [
          "Take the wagon north.",
          "Keep Gundren's trust while learning more on the road."
        ]
      },
      "mode_switch_decision": null,
      "memory_note": "The party interpreted Gundren's secrecy as excitement and caution."
    },
    {
      "public_narration": "Gundren notices the healing prayer, decides it is practical magic, and keeps the meeting moving.",
      "witness_reactions": [
        {
          "witness_id": "gundren-rockseeker",
          "reaction_category": "notices_but_ignores",
          "summary": "Gundren reads the magic as harmless support.",
          "public_text": "Useful trick. Save the rest of your strength for the road.",
          "private_note": "He files it away but does not object."
        }
      ],
      "scene_note": "Helpful public magic lands as useful rather than threatening here.",
      "dm_note": "No escalation from the healing spell.",
      "escalation": {
        "recommended": false,
        "reason": "",
        "mode_switch_decision": null
      }
    }
  ],
