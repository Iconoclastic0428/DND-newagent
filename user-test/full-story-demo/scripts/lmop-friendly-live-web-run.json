      "type": "command",
      "controller_id": "player-1-controller",
      "input": "/downtime start copy-wagon-ledger"
    },
    {
      "type": "command",
      "controller_id": "player-1-controller",
      "input": "/downtime work copy-wagon-ledger:player-1 2"
    },
