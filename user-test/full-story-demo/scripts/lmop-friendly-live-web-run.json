    {
      "type": "comment",
      "label": "Friendly live story declaration with a longer Gundren briefing"
    },
    {
      "type": "command",
      "controller_id": "player-1-controller",
      "input": "I thank Gundren for meeting us openly and ask what he is still being careful not to say about Phandalin."
    },
    {
      "type": "command_if_prompt",
      "controller_id": "player-1-controller",
      "prompt_kind": "story-check",
      "input": "/check"
    },
    {
      "type": "command",
      "controller_id": "player-2-controller",
      "input": "I tell Gundren I would rather hear the ugly version than the polished one, and ask what trouble he expects on the road before we ever see town."
    },
    {
      "type": "command_if_prompt",
      "controller_id": "player-2-controller",
      "prompt_kind": "story-check",
      "input": "/check"
    },
    {
      "type": "command",
      "controller_id": "player-3-controller",
      "input": "I reassure Sildar we can keep formation, then ask what kind of disappearance or rumor has him watching the trail so closely."
    },
    {
      "type": "command_if_prompt",
      "controller_id": "player-3-controller",
      "prompt_kind": "story-check",
      "input": "/check"
    },
    {
      "type": "command",
      "controller_id": "player-4-controller",
      "input": "I grin and ask whether this wagon is bait for thieves, and what name, cargo, or faction would make the wrong people in Phandalin suddenly interested in us."
    },
    {
      "type": "command_if_prompt",
      "controller_id": "player-4-controller",
      "prompt_kind": "story-check",
      "input": "/check"
    },
    {
      "type": "command",
      "controller_id": "player-1-controller",
      "input": "I tell Gundren we can keep confidence, compare watches with the others, and ask for one final piece of practical advice before departure."
    },
    {
      "type": "command_if_prompt",
      "controller_id": "player-1-controller",
      "prompt_kind": "story-check",
      "input": "/check"
    },
